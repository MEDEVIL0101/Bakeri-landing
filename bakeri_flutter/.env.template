# Copy this file to `.env` (gitignored) and fill in real values.
# Real values for this project are already sitting in the sibling iOS app at
# Bakerly/Bakerly/Bakeri/Config/Secrets.swift — copy them over rather than
# regenerating anything, unless you're deliberately spinning up a fresh
# Supabase/Stripe project instead of reusing the existing backend.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_...
ONESIGNAL_APP_ID=
SQUARE_APP_ID=

# Do NOT add SUPABASE_SERVICE_ROLE_KEY here — it never belongs in a client app.
# Anthropic key intentionally omitted — see README "Secrets" section.
